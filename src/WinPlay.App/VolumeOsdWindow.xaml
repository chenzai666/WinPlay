<Window
    x:Class="WinPlay.App.VolumeOsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinPlay volume">

    <Grid x:Name="Root" Width="420" Height="64" Background="Transparent">
        <Border
            CornerRadius="20"
            Padding="16,0"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0">
            <Grid VerticalAlignment="Center" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE767;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock
                    x:Name="NameText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource PrimaryTextBrush}"
                    FontSize="14"
                    TextTrimming="CharacterEllipsis"
                    Text="WinPlay" />
                <Grid
                    x:Name="BarTrack"
                    Grid.Column="2"
                    Height="6"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SliderTrackBrush}">
                    <Border
                        x:Name="BarFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentBrush}"
                        CornerRadius="3" />
                </Grid>
                <TextBlock
                    x:Name="PercentText"
                    Grid.Column="3"
                    MinWidth="48"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Foreground="{ThemeResource PrimaryTextBrush}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="20%" />
            </Grid>
        </Border>
        <TextBlock x:Name="TipText" Visibility="Collapsed" Text="WinPlay 音量" />
    </Grid>
</Window>
