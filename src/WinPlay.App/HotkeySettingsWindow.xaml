<Window
    x:Class="WinPlay.App.HotkeySettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinPlay 设置">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="SettingsTitleBar" Grid.Row="0" Background="Transparent" Padding="20,0,150,0">
            <TextBlock Text="WinPlay 设置" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
        </Grid>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="12,16" Background="{ThemeResource SidebarBrush}">
            <StackPanel Spacing="4">
                <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="8,0,0,12" />
                <RadioButton x:Name="NavGeneral" Style="{StaticResource SettingsNavigationStyle}" GroupName="SettingsNav" Checked="OnNavChecked" Tag="general">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="15" /><TextBlock Text="通用" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAudio" Style="{StaticResource SettingsNavigationStyle}" GroupName="SettingsNav" Checked="OnNavChecked" Tag="audio">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE767;" FontSize="15" /><TextBlock Text="音频" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavShortcuts" Style="{StaticResource SettingsNavigationStyle}" GroupName="SettingsNav" Checked="OnNavChecked" Tag="shortcuts">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE765;" FontSize="15" /><TextBlock Text="快捷键" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAbout" Style="{StaticResource SettingsNavigationStyle}" GroupName="SettingsNav" Checked="OnNavChecked" Tag="about">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE946;" FontSize="15" /><TextBlock Text="关于" /></StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="24,20">
            <Grid>
                <StackPanel x:Name="GeneralPage" Spacing="4">
                    <TextBlock Text="通用" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="登录时启动" Foreground="{ThemeResource PrimaryTextBrush}" />
                                <TextBlock Text="开机后留在托盘，不弹出设备卡片" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" HorizontalAlignment="Right" OffContent="" OnContent="" Toggled="OnStartupToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="磨砂玻璃" Foreground="{ThemeResource PrimaryTextBrush}" />
                                <TextBlock Text="设置窗口跟随强调色；设备面板和音量提示使用中性磨砂" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="GlassSwitch" Grid.Column="1" HorizontalAlignment="Right" OffContent="" OnContent="" Toggled="OnGlassToggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="玻璃通透度" Foreground="{ThemeResource PrimaryTextBrush}" />
                                <TextBlock x:Name="OpacityText" HorizontalAlignment="Right" Foreground="{ThemeResource SecondaryTextBrush}" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnOpacityChanged" />
                            <TextBlock Text="调整设备面板、设置窗口和音量提示的玻璃通透度。系统关闭透明效果或启用节能时可能使用纯色。" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="外观" Foreground="{ThemeResource PrimaryTextBrush}" />
                            <TextBlock Text="选择窗口外观；字体颜色与强调颜色可以独立调整。" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <ComboBox x:Name="ThemeSelector" SelectionChanged="OnThemeChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="深色" Tag="Dark" />
                            </ComboBox>
                            <TextBlock Text="字体颜色" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,8,0,0" />
                            <ComboBox x:Name="TextColorSelector" SelectionChanged="OnTextColorChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="自动（跟随主题）" Tag="auto" />
                                <ComboBoxItem Content="黑色" Tag="000000" />
                                <ComboBoxItem Content="深灰" Tag="3A3A3C" />
                                <ComboBoxItem Content="白色" Tag="F5F5F7" />
                                <ComboBoxItem Content="粉色" Tag="F4A5B0" />
                                <ComboBoxItem Content="蓝色" Tag="0A84FF" />
                            </ComboBox>
                            <TextBlock Text="字体颜色只影响文字。" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="强调颜色" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,8,0,0" />
                            <ComboBox x:Name="AccentColorSelector" SelectionChanged="OnAccentColorChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="自动（跟随 Windows 强调色）" Tag="auto" />
                                <ComboBoxItem Content="蓝色" Tag="0A84FF" />
                                <ComboBoxItem Content="粉色" Tag="F4A5B0" />
                                <ComboBoxItem Content="紫色" Tag="AF52DE" />
                                <ComboBoxItem Content="绿色" Tag="34C759" />
                                <ComboBoxItem Content="橙色" Tag="FF9500" />
                            </ComboBox>
                            <TextBlock Text="强调颜色影响设备选中状态、勾号和音量条。" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="高对比度模式使用系统文字颜色。" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AudioPage" Visibility="Collapsed" Spacing="4">
                    <TextBlock Text="音频" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="缓冲" Foreground="{ThemeResource PrimaryTextBrush}" />
                            <TextBlock Text="下次连接音箱时生效" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                            <RadioButton x:Name="BufferRealTime" Content="实时（约 0.3 秒）" GroupName="Buffer" Tag="RealTime" Checked="OnBufferChecked" />
                            <RadioButton x:Name="BufferLow" Content="低延迟（0.7 秒）" GroupName="Buffer" Tag="Low" Checked="OnBufferChecked" />
                            <RadioButton x:Name="BufferNormal" Content="普通（2 秒）" GroupName="Buffer" Tag="Normal" Checked="OnBufferChecked" />
                            <RadioButton x:Name="BufferBuffered" Content="缓冲（3 秒）" GroupName="Buffer" Tag="Buffered" Checked="OnBufferChecked" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ShortcutsPage" Visibility="Collapsed">
                    <TextBlock Text="快捷键" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SecondaryTextBrush}" Margin="0,0,0,12"
                               Text="点一下输入框，再按下新的组合键。也可以直接写成 Ctrl+Shift+F1 或 VolumeUp。推流时，键盘上的音量键仍然可用。" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="提高音量" VerticalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                                <TextBox x:Name="UpBox" Grid.Column="1" CornerRadius="8" GotFocus="OnChordFocus" PreviewKeyDown="OnChordKey" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="降低音量" VerticalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                                <TextBox x:Name="DownBox" Grid.Column="1" CornerRadius="8" GotFocus="OnChordFocus" PreviewKeyDown="OnChordKey" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="静音切换" VerticalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                                <TextBox x:Name="MuteBox" Grid.Column="1" CornerRadius="8" GotFocus="OnChordFocus" PreviewKeyDown="OnChordKey" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="恢复默认" Click="OnReset" />
                        <Button Content="取消" Click="OnCancel" />
                        <Button Content="保存" Click="OnSave" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="AboutPage" Visibility="Collapsed" Spacing="4">
                    <TextBlock Text="关于" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,12" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="VersionText" Foreground="{ThemeResource PrimaryTextBrush}" />
                            <TextBlock Text="把 Windows 的声音送到 AirPlay 音箱。" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="GitHub" Click="OnOpenGitHub" />
                                <Button Content="反馈问题" Click="OnOpenIssues" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        </Grid>
    </Grid>
</Window>
