<Window
    x:Class="WinPlay.App.HotkeySettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinPlay 快捷键">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="点一下输入框，再按下新的组合键。也可以直接写成 Ctrl+Shift+F1 或 VolumeUp。推流时，键盘上的音量键仍然可用。" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="提高音量" VerticalAlignment="Center" />
            <TextBox x:Name="UpBox" Grid.Column="1" GotFocus="OnChordFocus" PreviewKeyDown="OnChordKey" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="降低音量" VerticalAlignment="Center" />
            <TextBox x:Name="DownBox" Grid.Column="1" GotFocus="OnChordFocus" PreviewKeyDown="OnChordKey" />
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="静音切换" VerticalAlignment="Center" />
            <TextBox x:Name="MuteBox" Grid.Column="1" GotFocus="OnChordFocus" PreviewKeyDown="OnChordKey" />
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="4" TextWrapping="Wrap" Foreground="#F87171" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="恢复默认" Click="OnReset" />
            <Button Content="取消" Click="OnCancel" />
            <Button Content="保存" Click="OnSave" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
