<UserControl
    x:Class="WinPlay.App.Controls.HotkeyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Button x:Name="PreviewButton" Style="{StaticResource SettingsButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Click="OnEdit" ToolTipService.ToolTip="点击编辑快捷键">
            <ItemsControl x:Name="Keycaps">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border CornerRadius="5" BorderThickness="1" Padding="7,3" Background="{ThemeResource InputSurfaceBrush}" BorderBrush="{ThemeResource InputBorderBrush}">
                        <TextBlock Text="{Binding}" Foreground="{ThemeResource PrimaryTextBrush}" />
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </Button>
        <TextBox x:Name="Input" Visibility="Collapsed" Style="{StaticResource SettingsTextBoxStyle}"
                 TextChanged="OnTextChanged" PreviewKeyDown="OnChordKey" LostFocus="OnInputLostFocus"
                 PlaceholderText="按下组合键或输入快捷键" />
    </Grid>
</UserControl>
